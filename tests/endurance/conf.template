ZipSerialAPIPortName="/dev/serial/by-id/usb-Silicon_Labs_J-Link_Pro_OB_lamt-testbed-1-controller_000440155293-if00"

POLL_CMD="identify"
SUPERVISION="COMMAND_CLASS_SUPERVISION SUPERVISION_GET"
SWITCH_BINARY_SET_ON="042501FF00"
SWITCH_BINARY_SET_OFF="0425010000"
DOOR_LOCK_CONFIGURATION_GET="6205"
PIR_LOCK_CONFIGURATION_GET="6205"

# -- Step 05 automated SmartStart inclusion -----------------------------------
# Drives end-device inclusion in slot order with a two-phase FSM:
#   1. wait up to INCLUSION_START_TIMEOUT_S for INCLUSION_START_RE
#      (SmartStart actually began for *some* device);
#   2. then wait up to INCLUSION_DONE_TIMEOUT_S for INCLUSION_DONE_RE
#      (resource-directory probe completed) and check the node id.
#
# ZGW log on [zgw-host]. Tailed over SSH from [test-controller].
LOG_PATH="/var/log/zipgateway.log"
#   INCLUSION_START_RE    SmartStart actually began. Required. Source:
#                         CC_NetworkManagement.c FSM transition for the add.
INCLUSION_START_RE="nm_fsm_post_event event: NM_EV_ADD_END_NODE state: NM_NODE_FOUND"
#   INCLUSION_DONE_RE     resource-directory probe completion. Required.
#                         Source: ResourceDirectory.c "Probe of node %d is done".
INCLUSION_DONE_RE="Probe of node [0-9]+ is done"
#   INCLUSION_NODEID_RE   capture the decimal node id on the DONE line.
#                         Compared against slot + 4. Required.
INCLUSION_NODEID_RE="Probe of node [0-9]+ is done"
#   INCLUSION_START_TIMEOUT_S  wait for START after power-on, per attempt.
#                         If we never see it, the board never primed.
INCLUSION_START_TIMEOUT_S=30
#   INCLUSION_DONE_TIMEOUT_S   wait for DONE after START, per attempt.
#                         Covers S2 bootstrap + probe.
INCLUSION_DONE_TIMEOUT_S=120
#   INCLUSION_SETTLE_OFF_S  delay between power_off and power_on (seconds).
INCLUSION_SETTLE_OFF_S=2
#   INCLUSION_MAX_RETRIES  power-cycle retries before the operator prompt.
INCLUSION_MAX_RETRIES=3

BURST_SIZE=4
BURST_SLEEP=32

# Soft stop for the burst loop in run_on_host.sh. Format:
# <integer>[s|m|h|d] (e.g. 72h, 30m, 3d, 259200). Bare integer = seconds.
# CTRL+C remains the hard stop.
TEST_DURATION="72h"
