# Firmware URLs live in bed.tsv; fetch_artifacts.sh downloads them into
# ${ARTIFACTS_DIR}/ mirroring the Artifactory path.

# Per-slot bed description (board, device, role, route, region, firmware, bootloader, ...).
# Loaded by bed_load in utils.sh. Path is resolved at source time so all step
# scripts agree on the same file whether sourced from this folder or from
# ${ZGW_STAGE_DIR} on the zgw-host.
BED_TSV="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bed.tsv"

NL_WAKE_UP_INTERVAL_VALUE_SEC="000014"

ZGW_HOST=<ZGW_HOST>
ZGW_USER=pi
ZGW_STAGE_DIR=/home/$ZGW_USER/zgw-test-bench-stage
ZGW_REBOOT_WAIT_SEC=60

ZIP_GATEWAY="zipgateway-7.18.03-Linux-armhf.deb"
LIBZWAVEIP="libzwaveip-7.18.02-Linux-stretch-armhf-Binaries.zip"
LIBZWAVEIP_DIR="${LIBZWAVEIP%.zip}"
REFERENCE_CLIENT="${ZGW_STAGE_DIR}/${LIBZWAVEIP_DIR}/reference_client"
ZipLanGw6="<ZIP_LAN_GW6>"
ZipPanIp6="<ZIP_PAN_IP6>"
ZipLanIp6="<ZIP_LAN_IP6>"
