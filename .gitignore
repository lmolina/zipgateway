# General part of the gitignore
*.launch
*.orig
*.bak
.vscode/
**/.DS_Store
**/.idea/
**/.projectlinkstore
**/.settings
**/.makefile
**/.trash
**/.uceditor
**/autogen/*.crc
**/__pycache__
**/sonar-bw/
**/*.zap~

#code convention tool gitignore
code-convention-tool/
**/venv/
**/.venv/

# Per-run output (logs, captures).
tests/endurance/run_*/
tests/stress/run_*/

# Input binaries (CI artifacts, ZGW .deb). Tracked: only .gitkeep and README.
!artifacts/.gitkeep
!artifacts/README.md

artifacts/*

# Legacy artifact directory (pre-restructure layout).
endurance_test/
dist/

# input binaries belong in artifacts/, never elsewhere.
*.deb
*.s37
*.hex
*.zlf
*.zip
