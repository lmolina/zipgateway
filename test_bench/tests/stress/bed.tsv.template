#
# Bed description for the stress test. One row per slot.
# Tab-separated. Lines starting with '#' and blank lines are ignored.
# Loaded by utils.sh:bed_load and consumed by the 01/02/04/07 step scripts.
#
# Columns:
#   id           zero-based row id (matches dut_$i during flashing)
#   jlink_host   JLink-IP DNS name (port 4902 control, 5901 SWD)
#   board        Commander --board family (e.g. brd4205b, brd4401c)
#   device       Commander --device token (e.g. ZGM230S)
#   role         zniffer | controller | switch | door_lock | pir
#   route        PRIORITY_ROUTE_SET hex string; '-' for zniffer/controller
#   region       MFG_ZWAVE_COUNTRY_FREQ hex (e.g. 0x01=US, 0x00=EU, 0x09=US-LR); '-' for REGION from conf
#   firmware     full Artifactory URL (wget zip!/member syntax supported)
#   bootloader   full Artifactory URL; '-' if no separate bootloader
#
# Downloaded files mirror the path after /artifactory/ under ${artifacts}/.
#
# Topology of the routes below, in <id>-<role>
#   1-controller -> 2-switch
#   1-controller -> 3-switch
#   1-controller -> 2-switch -> 3-switch -> 4-switch
#   1-controller -> 2-switch -> 3-switch -> 4-switch -> 5-switch
#   1-controller -> 2-switch -> 3-switch -> 4-switch -> 5-switch -> 6-door_lock
#   1-controller -> 2-switch -> 3-switch -> 4-switch -> 5-switch -> 7-door_lock
#   1-controller -> 2-switch -> 3-switch -> 4-switch -> 5-switch -> 8-pir
#   1-controller -> 2-switch -> 3-switch -> 4-switch -> 5-switch -> 9-pir
#   1-controller -> 5-switch -> 10-switch
#   1-controller -> 11-switch
#   1-controller -> 12-switch
#   1-controller -> 13-door_lock
#   1-controller -> 14-door_lock
#   1-controller -> 10-switch -> 15-pir
#   1-controller -> 10-switch -> 4-switch -> 16-pir
#   1-controller -> 4-switch -> 5-switch -> 17-pir
#   1-controller -> 18-pir
#   1-controller -> 19-pir
#   1-controller -> 20-pir
#
