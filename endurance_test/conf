LOCATION=testbed-1

REGION="0x01"

# artifacts_layout selects how 01_fetch_artifacts.sh interprets artifacts_url:
#   col    -- Circle of Life pipeline drop in gsdk-generic-development;
#             URL points at a build folder containing build.xml,
#             conan.lock, and demo-applications.zip.
#   z-wave -- Package produced by the Z-Wave pipeline in zwave-conan-dev;
#             URL points at the package's export/metadata/ folder, which
#             holds demos/<board>/ (flashables) and debug/<board>/
#             (symbol ZIPs).
# The Z-Wave pipeline only publishes REGION_EU builds; the actual radio
# region is set at flash time via the MFG_ZWAVE_COUNTRY_FREQ token
# (see REGION below), so EU is the canonical download.
artifacts_layout="z-wave"
# artifacts_url="https://<HOST>/artifactory/gsdk-generic-development/sisdk-2025.12/2713"
artifacts_url="https://<HOST>/artifactory/zwave-conan-dev/silabs/zwave_sample_app/1.1.0-0.dev/task_lamolina_zwave_sdk-1751-endurance-test-8-1-0_test_1/32a78de462fe2285d913b10cdf6036fb6bf8ba33/export/metadata"
artifacts="artifacts"

# Per-slot bed description (board, device, role, firmware, route, ...).
# Loaded by bed.sh:bed_load. Path is resolved at source time so all step
# scripts agree on the same file whether sourced from this folder or from
# ${ZGW_STAGE_DIR} on the zgw-host.
BED_TSV="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bed.tsv"

NL_WAKE_UP_INTERVAL_VALUE_SEC="000014"

ZGW_HOST=<ZGW_HOST>
ZGW_USER=pi
ZGW_STAGE_DIR=/home/$ZGW_USER/zgw-test-bench-stage
ZGW_REBOOT_WAIT_SEC=60

ZIP_GATEWAY="zipgateway-7.18.03-Linux-armhf.deb"
LIBZWAVEIP="libzwaveip-7.18.02-Linux-stretch-armhf-Binaries.zip"
LIBZWAVEIP_DIR="${LIBZWAVEIP%.zip}"
REFERENCE_CLIENT="${ZGW_STAGE_DIR}/${LIBZWAVEIP_DIR}/reference_client"
ZipLanGw6="<ZIP_LAN_GW6>"
ZipPanIp6="<ZIP_PAN_IP6>"
ZipLanIp6="<ZIP_LAN_IP6>"
ZipPSK="<ZIP_PSK>"
ZipSerialAPIPortName="/dev/serial/by-id/usb-Silicon_Labs_J-Link_Pro_OB_lamt-testbed-1-controller_000440155293-if00"

POLL_CMD="identify"
SUPERVISION="COMMAND_CLASS_SUPERVISION SUPERVISION_GET"
SWITCH_BINARY_SET_ON="042501FF00"
SWITCH_BINARY_SET_OFF="0425010000"
DOOR_LOCK_CONFIGURATION_GET="6205"
PIR_LOCK_CONFIGURATION_GET="6205"

BURST_SIZE=4
